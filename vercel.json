{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:lang(es|en)/:old(about|prototype)/",
      "destination": "/:lang/",
      "permanent": false
    }
  ]
}
